{
  "name": "@foundrydb/sdk",
  "version": "0.10.0",
  "description": "JavaScript/TypeScript SDK for the FoundryDB managed database platform",
  "keywords": [
    "foundrydb",
    "managed-database",
    "postgresql",
    "mysql",
    "mongodb",
    "valkey",
    "kafka"
  ],
  "homepage": "https://foundrydb.com",
  "repository": {
    "type": "git",
    "url": "https://github.com/anorph/foundrydb-sdk-js.git"
  },
  "license": "MIT",
  "author": "Anorph",
  "type": "module",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "require": "./dist/cjs/index.cjs",
      "types": "./dist/index.d.ts"
    }
  },
  "main": "./dist/cjs/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc && node scripts/build-cjs.mjs",
    "build:esm": "tsc",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "npm run build",
    "test": "jest --coverage"
  },
  "jest": {
    "preset": "ts-jest",
    "testEnvironment": "node",
    "moduleNameMapper": {
      "^(.*)\\.js$": "$1"
    },
    "transform": {
      "^.+\\.tsx?$": [
        "ts-jest",
        {
          "tsconfig": "./tsconfig.test.json"
        }
      ]
    },
    "collectCoverageFrom": [
      "src/**/*.ts",
      "!src/**/*.d.ts",
      "!src/index.ts"
    ]
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "devDependencies": {
    "@types/jest": "^30.0.0",
    "@types/node": "^25.5.0",
    "jest": "^30.3.0",
    "ts-jest": "^29.4.6",
    "typescript": "^5.4.5"
  }
}
